pipeline {
    agent any
      parameters {
    string(name: 'USER', description: 'Enter your name')
  }

    stages {

        stage('Building') {
            steps {
                sh '''

                     #chmod +x hello.sh
                     #./hello.sh
                     echo Hello, ${params.USER}

                    '''
                 
            }
        }
      
    }
}
