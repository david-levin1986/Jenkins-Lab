pipeline {
    agent any

    stages {
        stage('Hello') {
            steps {
                echo 'Hello From Jenkins'
            }
        }
        stage('Building') {
            steps {
                sh '''
                    rm -rf hello.sh
                    echo echo "Hellow Wold" >> hello.sh
                    ./hello.sh



                    '''
                 
            }
        }
    }
}
