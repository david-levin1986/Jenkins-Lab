pipeline {
    agent any
  parameters {
    string(name: 'CLASS', defaultValue: 'Jenkins', description: 'Enter your class name')
  }




    stages {

        stage('Building') {
            steps {
                  sh '''
                    chmod +x hello.sh
                    ./hello.sh
                    echo Hello, ${params.CLASS}
                '''       
            }
        }
      
    }
}
