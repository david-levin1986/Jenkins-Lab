pipeline {
    agent any
   parameters {
    string(name: 'CLASS', defaultValue: 'Your class', description: 'Enter your class')
  }





    stages {

        stage('Building') {
            steps {
                  sh '''
                    chmod +x hello.sh
                    ./hello.sh
                    echo Hello, ${CLASS}
                '''       
            }
        }
      
    }
}
