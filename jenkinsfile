pipeline {
    agent any

    stages {
        stage('Hello') {
            steps {
                echo 'Hello From Jenkins'
            }
        }
        stage('Building') {
            steps {
                sh 'touch hello.sh'
                sh 'chmod +x hello.sh'
                sh 'echo "echo "Hello Wold"" >> hello.sh'
                sh 'cat hello.sh'
            }
        }
    }
}
