pipeline {
    agent any
   parameters {
    string(name: 'CLASS', defaultValue: 'Jenkins', description: 'Enter Your Class Name')
  }





    stages {

        stage('Building') {
            steps {
                  sh '''
                    chmod +x hello.sh
                    ./hello.sh
                    echo Wellcom to, ${CLASS} Class
                '''       
            }
        }

         stage('Testing File') {
            steps {
            sh '''
                if [ "$(./hello.sh)" = "Git and Jenkins!" ]; then
                echo "Test passed"
                exit 0
            else
                echo "Test failed"
                exit 1
            fi
    '''      
            }
        }
      
    }
}
