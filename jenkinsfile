pipeline {
    agent any
        parameters {
    string(name: 'CLASS', defaultValue: 'Jenkins', description: 'Enter Class Name')
  }



    stages {

        stage('Building') {
            steps {
                  sh '''
                    chmod +x hello.sh
                    ./hello.sh
                    echo Wellcom to , ${CLASS} clas
                '''       
            }
        }
      
    }
}
