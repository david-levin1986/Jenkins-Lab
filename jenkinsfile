pipeline {
    agent any
   parameters {
    string(name: 'CLASS', defaultValue: 'Jenkins', description: 'Enter Your Class Name')
  }





    stages {

        stage('Building') {
            steps {
                  sh '''
                    chmod +x hello.sh
                    ./hello.sh
                    echo Wellcom to, ${CLASS} Class
                '''       
            }
        }

         stage('Testing File') {
            steps {
                  sh '''
                    if [ "$(./hello.sh)" == "David Levin" ]; then
                    echo "test pass"
                    exit 0
                    else
                    echo "test faild"
                    exit 1
                    fi
                '''       
            }
        }
      
    }
}
