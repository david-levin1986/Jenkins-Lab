pipeline {
    agent any
   parameters {
    string(name: 'USER', defaultValue: 'Your Name', description: 'Enter your name')
  }





    stages {

        stage('Building') {
            steps {
                  sh '''
                    chmod +x hello.sh
                    ./hello.sh
                    echo Hello, ${USER}
                '''       
            }
        }
      
    }
}
