pipeline {
    agent any

    stages {
        stage('Hello') {
            steps {
                echo 'Hello From Jenkins'
            }
        }
        stage('Building') {
            steps {
                sh '''
                    #sudo rm -rf hello.sh
                     echo echo "Hellow Wold" >> hello.sh
                     chmod +x hello.sh
                     ./hello.sh



                    '''
                 
            }
        }
    }
}
